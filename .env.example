# Google Sheets is the primary data source. leads.csv remains the fallback.
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET_NAME=Leads
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Local fallback used only when Google Sheets is unavailable.
LEADS_CSV_PATH=leads.csv

# Required for AI analysis. Create a key at https://console.groq.com/keys
GROQ_API_KEY=

# Public-web lead collector. Default coverage is Agadir and Marrakech.
LEAD_CITIES=Agadir,Marrakech
# Optional comma-separated override. Leave empty to use COLLECTION_SECTORS in lead_collector.py.
LEAD_SECTORS=
LEAD_MAX_RESULTS_PER_SECTOR_CITY=5
LEAD_MAX_TOTAL_PER_RUN=100
LEAD_REQUEST_DELAY_MIN=1.5
LEAD_REQUEST_DELAY_MAX=3.0
LEAD_REQUEST_TIMEOUT=15
# Set to true to collect candidates without reading or writing Google Sheets.
LEAD_DRY_RUN=false
